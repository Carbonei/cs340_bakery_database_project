<h1>Customers</h1>
{{! Citation: Date: 5/8/2026 below code Adapted from Web Exploration Module  https://canvas.oregonstate.edu/courses/2042369/pages/exploration-web-application-technology-2?module_item_id=26640188  }}

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each Customers.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
        </tr>

    </thead>

    <tbody>
        {{! For each row, print the ID, first name, last name, and email }}
                 </button>
             {{#each Customers}}
        <tr>
            <td>{{this.customer_ID}}</td>
            <td>{{this.first_name}}</td>
            <td>{{this.last_name}}</td>
            <td>{{this.email}}</td>
           
           

            {{! DELETE form }}
            <form id='delete_customer_form' method='POST' action='/Customers/delete'>
                <input type='hidden' name='delete_customer_id' value='{{this.customer_ID}}' />
                <input type='hidden' name='delete_customer_name' value='{{this.first_name}} {{this.last_name}}' />
                <td>
                    <button type='submit'>
                        Delete
              </td>
            </form>
        </tr>
        {{/each}}
        
        
    </tbody>
</table>

<p class="required-alert">All labels for input/selector fields that are required are marked with '*'.</p>

{{! CREATE form }}
<h2>Create a Customer</h2>
<form class='cuForm' id='create_customer_form'  method='POST' action='/Customers/create'>
    <label for='create_customer_first_name'>First Name*: </label>
    <input type='text' name='create_customer_first_name' id='create_customer_first_name' required />

    <label for='create_customer_last_name'>Last Name*: </label>
    <input type='text' name='create_customer_last_name' id='create_customer_last_name' />
 

    <label for='create_customer_email'>Email*:</label>
    <input type='text' name='create_customer_email' id='create_customer_email' />

    <input type='submit' /> 
</form>

{{! UPDATE form }}
<h2>Update a Customer</h2>
<form class='cuForm' id='update_customer_form' method='POST' action='/Customers/update'>
    <label for='update_customer_id'>Customer to Update*: </label>
    <select name='update_customer_id' id='update_customer_id' required>
        <option value='' disabled selected>Select a Customer</option>
        {{#each Customers}}
        <option value='{{this.customer_ID}}' required>
            {{this.customer_ID}}
            
            {{this.first_name}}
            {{this.last_name}}
        </option>
        {{/each}}
    </select>
    
    <label for='update_customer_first_name'>First Name*:</label>
    <input type='text' name='update_customer_first_name' id='update_customer_first_name' />

    <label for='update_customer_last_name'>Last Name*:</label>
    <input type='text' name='update_customer_last_name' id='update_customer_last_name' />

    <label for='update_customer_email'>Email*: </label>
    <input type='text' name='update_customer_email' id='update_customer_email' />

    <input type='submit' />
</form>

<h2>Reset Data</h2>

<form id='customer_reset' method='POST' action='/Customers/reset'>
                
    <td>
        <button type='submit'>
            Reset
    </td>
</form>
