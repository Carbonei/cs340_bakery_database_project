<h1>Customer Stores</h1>
{{! Citation: Adapted from Web Exploration Module (link when canvas is accessable) }}

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each Customer_Stores.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
        </tr>

    </thead>

    <tbody>
        {{! For each row, print the ID, customer ID, first name, last name, location ID, and location name }}
                 </button>
             {{#each Customer_Stores}}
        <tr>
            <td>{{this.customer_storeID}}</td>
            <td>{{this.customer_ID}}</td>
            <td>{{this.first_name}}</td>
            <td>{{this.last_name}}</td>
            <td>{{this.location_ID}}</td>
            <td>{{this.location_name}}</td>


            {{! DELETE form }}
            <form id='delete_customer_store_form'>
                <input type='hidden' name='delete_customer_store_id' value='{{this.customer_storeID}}' />
                <input type='hidden' name='delete_customer_store_customerID' value='{{this.customer_ID}}' />
                <input type='hidden' name='delete_customer_store_customer_fname' value='{{this.first_name}}' />
                <input type='hidden' name='delete_customer_store_customer_lname' value='{{this.last_name}}' />
                <input type='hidden' name='delete_customer_store_locationID' value='{{this.location_ID}}' />
                <input type='hidden' name='delete_customer_store_location_name' value='{{this.location_name}}' />

                <td>
                    <button type='submit'>
                        Delete
              </td>
            </form>
        </tr>
        {{/each}}
        
        
    </tbody>
</table>

{{! CREATE form }}
<h2>Create a Customer Store</h2>
<form class='cuForm' id='create_customer_store_form'>
    <label for='create_customer_store_customerID'>Customer ID: </label>
    <select name='create_customer_store_customerID' id='create_customer_store_customerID' required>
        <option value='' disabled selected>Select a Customer</option>
        {{#each customers}}
        <option value='{{this.customer_ID}}' required>
            {{this.customer_ID}}
        </option>
        {{/each}}
    </select>
    <label for='create_customer_store_locationID'>Store Location ID: </label>
    <select name='create_customer_store_locationID' id='create_customer_store_locationID'>
        <option value='NULL' disabled selected>Select a Location</option>
        {{#each locations}}
        <option value='{{this.location_ID}}' required>
            {{this.location_ID}}
        </option>
        {{/each}}
    </select>
    <input type='submit' /> 
</form>

{{! UPDATE form }}
<h2>Update a Customer Store</h2>
<form class='cuForm' id='update_customer_form'>
    <label for='update_customer_store_id'>Customer Store to Update: </label>
    <select name='update_customer_store_id' id='update_customer_store_id' required>
        <option value='' disabled selected>Select a Customer Store</option>
        {{#each Customer_Stores}}
        <option value='{{this.customer_storeID}}' required>
            {{this.customer_storeID}}
        </option>
        {{/each}}
    </select>

    <label for='update_customer_store_customerID'>Customer Store Customer to Update: </label>
    <select name='update_customer_store_customerID' id='update_customer_store_customerID' required>
        <option value='' disabled selected>Select a Customer Store Customer</option>
        {{#each customers}}
        <option value='{{this.customer_ID}}' required>
            {{this.customer_ID}}
        </option>
        {{/each}}
    </select>
    
    <label for='update_customer_store_locationID'>Customer Store Location to Update: </label>
    <select name='update_customer_store_locationID' id='update_customer_store_locationID' required>
        <option value='' disabled selected>Select a Customer Store Location</option>
        {{#each locations}}
        <option value='{{this.location_ID}}' required>
            {{this.location_ID}}
        </option>
        {{/each}}
    </select>
    
    <input type='submit' />
</form>