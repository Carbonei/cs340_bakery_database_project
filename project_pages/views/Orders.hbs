<h1>Orders</h1>
{{! Citation: Adapted from Web Exploration Module (link when canvas is accessable) }}
{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each Orders.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
        </tr>

    </thead>

    <tbody>
        {{! For each row, print the id, cost, count, pickup date, first name, last name, and location name}}
                 </button>
             {{#each Orders}}
        <tr>
            <td>{{this.order_ID}}</td>
            <td>{{this.order_cost}}</td>
            <td>{{this.item_count}}</td>
            <td>{{this.[pickup_date]}}</td>
            <td>{{this.first_name}}</td>
            <td>{{this.last_name}}</td>
            
            <td>{{this.location_name}}</td>
           
           

            {{! DELETE form }}
            <form id='delete_order_form' method='POST' action='/Orders/delete'>
                <input type='hidden' name='delete_order_id' value='{{this.order_ID}}' />
                <input type='hidden' name='delete_order_name' value='{{this.first_name}} {{this.last_name}}' />
                <td>
                    <button type='submit'>
                        Delete
              </td>
            </form>
        </tr>
        {{/each}}
        
        
    </tbody>
</table>

<p class="required-alert">All labels for input/selector fields that are required are marked with '*'.</p>

{{! CREATE form }}
<h2>Create an Order</h2>
<form class='cuForm' id='create_order_form'  method='POST' action='/Orders/create'>
    <label for='create_order_cost'>Order Cost*: </label>
    <input type='text' name='create_order_cost' id='create_order_cost' required />

    <label for='create_order_item_count'>Item Count*: </label>
    <input type='text' name='create_order_item_count' id='create_order_item_count' />

    <label for='create_order_customer_ID'>Customer Name*: </label>
    <select name='create_order_customer_ID' id='create_order_customer_ID' required>
        <option value="" disabled selected>Select a Customer</option>
        {{#each Orders}}
        <option value='{{this.customer_ID}}' required>
            {{this.customer_ID}}
            
            {{this.first_name}}
            {{this.last_name}}
        </option>
        {{/each}}
    </select>

    <label for='create_order_pickup'>Pickup Date*(enter in 'YYYY-MM-DD' format): </label>
    <input type='text' name='create_order_pickup' id='create_order_pickup' />

    <label for='create_order_location_ID'>Location Name*: </label>
    <select name='create_order_location_ID' id='create_order_location_ID' required>
        <option value="" disabled selected>Select a Location</option>
        {{#each locations}}
        <option value='{{this.location_ID}}' required>
            {{this.location_ID}}
            {{this.location_name}}
        </option>
        {{/each}}
    </select>
    <input type='submit' /> 
</form>

{{! UPDATE form }}
<h2>Update an Order</h2>
<form class='cuForm' id='update_order_form'>
    <label for='update_order_id'>Order to Update*: </label>
    <select name='update_order_id' id='update_order_id' required>
        <option value='' disabled selected>Select an Order</option>
        {{#each Orders}}
        <option value='{{this.order_ID}}' required>
            {{this.order_ID}}
        </option>
        {{/each}}
    </select>
    
    <label for='update_order_email'>Order Cost:</label>
    <input type='text' name='update_order_cost' id='update_order_first_name' />

    <label for='update_order_email'>Item count:</label>
    <input type='text' name='update_order_last_name' id='update_order_last_name' />

    <label for='create_order_pickup'>Pickup Date: </label>
    <input type='text' name='update_order_pickup' id='crud_order_pickup' />

    <label for='update_order_age'>Location Name: </label>
    <select name='update_order_location' id='update_order_location'>
        <option value='NULL' disabled selected>Select a Location</option>
        {{#each locations}}
        <option value='{{this.location_ID}}' required>
            {{this.location_name}}
        </option>
        {{/each}}
    </select>
    <input type='submit' />
</form>

<h2>Reset Data</h2>

<form id='order_reset'  method='POST' action='/Orders/reset'>
                
    <td>
        <button type='submit'>
            Reset
    </td>
</form>