<h1>Stores</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each Stores.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the ID, location name, and the count of total transactions }}
                 </button>
             {{#each Stores}}
        <tr>
            <td>{{this.location_ID}}</td>
            <td>{{this.location_name}}</td>
            <td>{{this.total_transaction_count}}</td>
           

            {{! DELETE form }}
            <form id='delete_store_form' method='POST' action="/Stores/delete">
                <input type='hidden' name='delete_location_id' value='{{this.location_ID}}' />
                <input type='hidden' name='delete_location_name' value='{{this.location_name}}' />
                <input type='hidden' name='delete_transaction_count' value='{{this.total_transaction_count}}' />
                <td>
                    <button type='submit'>
                        Delete
                    </button>
                </td>
            </form>
        </tr>
        {{/each}}
    </tbody>
</table>

<p class="required-alert">All labels for input/selector fields that are required are marked with '*'.</p>

{{! CREATE form }}
<h2>Create a Store</h2>
<form class='cuForm' id='create_store_form' method='POST' action='/Stores/create'>
    <label for='create_location_name'>Location Name*: </label>
    <input type='text' name='create_location_name' id='create_location_name' required />

    <label for='create_transaction_count'>Total Transaction Count*: </label>
    <input type='text' name='create_transaction_count' id='create_transaction_count' />

    <input type='submit' /> 
</form>

{{! UPDATE form }}
<h2>Update a Store</h2>
<form class='cuForm' id='update_store_form' method='POST' action='/Stores/update'>
    <label for='update_location_id'>Store Location to Update*: </label>
    <select name='update_location_id' id='update_location_id' required>
        <option value='' disabled selected>Select a Location</option>
        {{#each Stores}}
        <option value='{{this.location_ID}}' required>
            {{this.location_ID}}

            {{this.location_name}}
        </option>
        {{/each}}
    </select>

    <label for="update_location_name">Location Name*:</label>
    <input type='text' name='update_location_name' id='update_location_name' />

    <label for="update_transaction_count">Total Transaction Count*:</label>
    <input type='text' name='update_transaction_count' id='update_transaction_count' />
    <input type='submit' />
</form>

<h2>Reset Data</h2>

<form id='store_reset' method='POST' action='/Stores/reset'>
                
    <td>
        <button type='submit'>
            Reset
    </td>
</form>
