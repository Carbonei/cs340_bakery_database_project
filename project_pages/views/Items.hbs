<h1>Items</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each Items.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the ID, cost, name, and location name }}
                 </button>
             {{#each Items}}
        <tr>
            <td>{{this.item_ID}}</td>
            <td>{{this.item_cost}}</td>
            <td>{{this.item_name}}</td>
            <td>{{this.location_name}}</td>
           

            {{! DELETE form }}
            <form id='delete_item_form'>
                <input type='hidden' name='delete_item_id' value='{{this.item_ID}}' />
                <input type='hidden' name='delete_item_cost' value='{{this.item_cost}}' />
                <input type='hidden' name='delete_item_name' value='{{this.item_name}}' />
                <input type='hidden' name='delete_location_name' value='{{this.location_name}}' />
                <td>
                    <button type='submit'>
                        Delete
              </td>
            </form>
        </tr>
        {{/each}}
        
    </tbody>
</table>

{{! CREATE form }}
<h2>Create an Item</h2>
<form class='cuForm' id='create_item_form'>
    <label for='create_item_cost'>Item Cost: </label>
    <input type='text' name='create_item_cost' id='create_item_cost' required />

    <label for='create_item_name'>Item Name: </label>
    <input type='text' name='create_item_name' id='create_item_name' required />

    <label for='create_item_location'>Item Location: </label>
    <select name='create_item_location' id='create_item_location'>
        <option value='NULL' disabled selected>Select a Location</option>
        <option value='NULL'>&lt; None &gt;</option>
        {{#each locations}}
        <option value='{{this.location_ID}}' required>
            {{this.location_name}}
        </option>
        {{/each}}
    </select>
    <input type='submit' /> 
</form>

{{! UPDATE form }}
<h2>Update an Item</h2>
<form class='cuForm' id='update_item_form'>
    <label for='update_item_id'>Item to Update: </label>
    <select name='update_item_id' id='update_item_id' required>
        <option value='' disabled selected>Select an Item</option>
        {{#each Items}}
        <option value='{{this.item_ID}}' required>
            {{this.item_ID}}

            {{this.item_name}}
        </option>
        {{/each}}
    </select>

    <label for="update_item_cost">Item Cost:</label>
    <input type='text' name='update_item_cost' id='update_item_cost' />

    <label for="update_item_name">Item Name:</label>
    <input type='text' name='update_item_name' id='update_item_name' />

    <label for='update_item_location'>Item Location: </label>
    <select name='update_item_location' id='update_item_location'>
        <option value='NULL' disabled selected>Select a Location</option>
        <option value='NULL'>&lt; None &gt;</option>
        {{#each locations}}
        <option value='{{this.location_ID}}' required>
            {{this.location_name}}
        </option>
        {{/each}}
    </select>

    <input type='submit' />
</form>
