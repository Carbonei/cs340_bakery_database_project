<h1>Customers</h1>

{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each Customers.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
        </tr>
    {{!--
        <tr>
            {{#each Stores.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
        </tr>
        --}}
    </thead>

    <tbody>
        {{! For each row, print the id, fname, lname, homeworld and age }}
                 </button>
             {{#each Items}}
        <tr>
            <td>{{this.item_ID}}</td>
            <td>{{this.item_cost}}</td>
            <td>{{this.item_name}}</td>
            <td>{{this.location_name}}</td>
           

            {{! DELETE form }}
            <form id='delete_person_form'>
                <input type='hidden' name='delete_person_id' value='{{this.customer_ID}}' />
                <input type='hidden' name='delete_person_name' value='{{this.first_name}} {{this.last_name}}' />
                <td>
                    <button type='submit'>
                        Delete
              </td>
            </form>
        </tr>
        {{/each}}
        
    </tbody>
</table>

{{! CREATE form }}
<h2>Create an Item</h2>
<form class='cuForm' id='create_item_form'>
    <label for='create_item_cost'>Item Cost </label>
    <input type='text' name='create_item_cost' id='create_item_cost' required />

    <label for='create_person_lname'>Last Name: </label>
    <input type='text' name='create_person_lname' id='create_person_lname' />

    <label for='create_person_homeworld'>Store: </label>
    <select name='create_person_homeworld' id='create_person_homeworld'>
        <option value='NULL' selected>Select a store location</option>
        <option value='NULL'>&lt; None &gt;</option>
        {{#each Stores}}
        <option value='{{this.customer_ID}}' required>{{this.location_name}}</option>
        {{/each}}
    </select>

    <label for='create_person_age'>Age:</label>
    <input type='number' name='create_person_age' id='create_person_age' min='0' />

    <input type='submit' /> 
</form>

{{! UPDATE form }}
<h2>Update a Person</h2>
<form class='cuForm' id='update_person_form'>
    <label for='update_person_id'>Person to Update: </label>
    <select name='update_person_id' id='update_person_id' required>
        <option value='' disabled selected>Select a Person</option>
        {{#each Customers}}
        <option value='{{this.customer_ID}}' required>
            {{this.customer_ID}}
            
            {{this.first_name}}
            {{this.last_name}}
        </option>
        {{/each}}
    </select>

    <label for='update_person_homeworld'>Homeworld: </label>
    <select name='update_person_homeworld' id='update_person_homeworld'>
        <option value='NULL' disabled selected>Select a Planet</option>
        <option value='NULL'>&lt; None &gt;</option>
        {{#each Stores}}
        <option value='{{this.location_ID}}' required>
            {{this.location_name}}
        </option>
        {{/each}}
    </select>

    <label for='update_person_age'>Email: </label>
    <input type='number' name='update_person_age' id='update_person_age' min='0' />

    <input type='submit' />
</form>
